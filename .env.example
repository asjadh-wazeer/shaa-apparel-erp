# ============================================================
# SHAA Apparel ERP — Environment Configuration
# Copy to .env and fill all values before running
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NODE_ENV=development
APP_PORT=3001
APP_NAME="SHAA Apparel ERP"
APP_VERSION=1.0.0
APP_FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------
# Database — MySQL
# ------------------------------------------------------------
DATABASE_URL="mysql://erp_user:erp_password@localhost:3306/shaa_erp_db"
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=shaa_erp_db
DATABASE_USER=erp_user
DATABASE_PASSWORD=erp_password
DATABASE_ROOT_PASSWORD=root_password

# ------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------
JWT_ACCESS_SECRET=change_this_access_secret_min_64_chars_long_production_value
JWT_REFRESH_SECRET=change_this_refresh_secret_min_64_chars_long_production_value
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=3600

# ------------------------------------------------------------
# MinIO / S3-Compatible Storage
# ------------------------------------------------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=shaa-erp-files

# ------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_TTL_SECONDS=60
AUTH_THROTTLE_LIMIT=10

# ------------------------------------------------------------
# Bcrypt
# ------------------------------------------------------------
BCRYPT_ROUNDS=12

# ------------------------------------------------------------
# BullMQ / Queue
# ------------------------------------------------------------
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=

# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY_PRINT=true

# ------------------------------------------------------------
# SaaS / Multi-Tenancy
# ------------------------------------------------------------
DEFAULT_TENANT_ID=default-tenant
SAAS_MODE=false

# ------------------------------------------------------------
# Swagger / API Docs
# ------------------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs
SWAGGER_TITLE="SHAA Apparel ERP API"
SWAGGER_DESCRIPTION="Production-grade Garment Manufacturing ERP REST API"
